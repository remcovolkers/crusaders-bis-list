{
  "name": "crusaders-bis-list-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/crusaders-bis-list-frontend/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/crusaders-bis-list-frontend",
        "browser": "apps/crusaders-bis-list-frontend/src/main.ts",
        "tsConfig": "apps/crusaders-bis-list-frontend/tsconfig.app.json",
        "polyfills": [
          "zone.js"
        ],
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/crusaders-bis-list-frontend/public"
          }
        ],
        "styles": [
          "apps/crusaders-bis-list-frontend/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/crusaders-bis-list-frontend/src/environments/environment.ts",
              "with": "apps/crusaders-bis-list-frontend/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/crusaders-bis-list-frontend/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "crusaders-bis-list-frontend:build:production"
        },
        "development": {
          "buildTarget": "crusaders-bis-list-frontend:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
          "command": "tsc --noEmit -p apps/crusaders-bis-list-frontend/tsconfig.app.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "crusaders-bis-list-frontend:build",
        "port": 4200,
        "staticFilePath": "dist/apps/crusaders-bis-list-frontend/browser",
        "spa": true
      }
    }
  }
}